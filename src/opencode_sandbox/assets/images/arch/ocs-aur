#!/usr/bin/python3 -I
"""ocs-aur: install AUR packages in an OpenCode Sandbox container (D-006).

makepkg refuses to run as root, and the container runs with no-new-privileges, so sudo cannot
raise privileges. Run by root, this command starts the AUR helper as the unprivileged build
user `aurbuild` in its home /var/lib/aurbuild (never in /workspace) and gives the helper a
`--sudo` program that asks this process to run pacman as root. The broker accepts only pacman,
only from `aurbuild` processes started directly by the helper (not from PKGBUILD code that
the helper runs through makepkg), and only while this command runs.

`aurbuild` exists because makepkg refuses root; it is not a security boundary against the
packages you choose to install: their install scripts and files run as root.

Usage (as root): ocs-aur ARGS...   ARGS go to the AUR helper, e.g. -S PACKAGE, -Ss TERM, -Sua
"""
import array
import json
import os
import pwd
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

HELPER = "/usr/bin/paru"
USER = "aurbuild"
RUN_DIR = Path("/run/ocs-aur")
SUDO = "/usr/local/lib/ocs-aur/sudo"
PACMAN = "/usr/bin/pacman"
WORKSPACE = "/workspace"
# Options that would point pacman at another root, database, config, hooks or keyring.
PACMAN_REFUSED = ("--root", "--dbpath", "--config", "--hookdir", "--gpgdir", "--sysroot", "--cachedir", "--logfile",
                  "-r", "-b")
# Except these exact values (yay passes `--config /etc/pacman.conf`).
PACMAN_DEFAULTS = {"--config": "/etc/pacman.conf"}
HELPER_REFUSED = ("--clonedir", "--builddir", "--chroot", "--sudo", "--sudoflags", "--sudoloop", "--makepkg",
                  "--pacman", "--makepkgconf", "--config", "--root", "--dbpath")
KEEP_ENV = ("TERM", "COLORTERM", "NO_COLOR", "LANG", "LC_ALL", "LC_CTYPE", "LC_MESSAGES", "COLUMNS", "LINES",
            "http_proxy", "https_proxy", "no_proxy", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "ALL_PROXY")
MAX_REQUEST = 1 << 20


def fail(message, code=2):
    print(f"ocs-aur: {message}", file=sys.stderr)
    sys.exit(code)


def clean_env(**extra):
    env = {k: v for k, v in os.environ.items() if k in KEEP_ENV}
    env["PATH"] = "/usr/local/bin:/usr/bin"
    env.setdefault("LANG", "C.UTF-8")
    env.update(extra)
    return env


def refused_option(arg, options):
    return arg in options or any(arg.startswith(o + "=") for o in options if o.startswith("--"))


def pacman_refused(arg):
    """pacman (getopt_long) also accepts combined short options (`-Sr /x`, `-Qb/x`) and
    unambiguous prefixes of long options (`--roo`, `--hookd=`)."""
    if refused_option(arg, PACMAN_REFUSED):
        return True
    if arg.startswith("--"):
        name = arg[2:].partition("=")[0]
        return len(name) >= 1 and any(o.startswith("--" + name) for o in PACMAN_REFUSED if o.startswith("--"))
    if arg.startswith("-") and len(arg) > 2:
        letters = {o[1] for o in PACMAN_REFUSED if len(o) == 2}
        return any(ch in letters for ch in arg[1:])
    return False


def under_workspace(arg):
    if "/" not in arg:
        return False
    value = arg.split("=", 1)[1] if arg.startswith("--") and "=" in arg else arg
    try:
        path = os.path.realpath(value)
    except (OSError, ValueError):
        return False
    return path == WORKSPACE or path.startswith(WORKSPACE + "/")


# -- client side: the helper runs this as `sudo pacman ARGS` (user aurbuild) -------------------

def elevate(argv):
    path = os.environ.get("OCS_AUR_SOCKET")
    if not path:
        fail("this program only works inside `ocs-aur` (run ocs-aur as root)", 1)
    request = json.dumps({"argv": argv, "cwd": os.getcwd()}).encode()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(path)
        fds = array.array("i", [0, 1, 2])
        s.sendmsg([struct.pack("!I", len(request)) + request], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, fds)])
        reply = b""
        while chunk := s.recv(4096):
            reply += chunk
    try:
        return int(json.loads(reply)["rc"])
    except (ValueError, KeyError, TypeError):
        return 1


# -- broker side: root, for the lifetime of one ocs-aur command ----------------------------------

def receive(conn):
    fds = array.array("i")
    data, ancdata, _flags, _addr = conn.recvmsg(65536, socket.CMSG_LEN(3 * fds.itemsize))
    for level, kind, payload in ancdata:
        if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
            fds.frombytes(payload[:len(payload) - len(payload) % fds.itemsize])
    try:
        if len(data) < 4:
            raise ValueError("short request")
        size = struct.unpack("!I", data[:4])[0]
        if size > MAX_REQUEST:
            raise ValueError("request too large")
        body = data[4:]
        while len(body) < size:
            chunk = conn.recv(size - len(body))
            if not chunk:
                raise ValueError("truncated request")
            body += chunk
        request = json.loads(body)
        if len(fds) != 3:
            raise ValueError("expected three file descriptors")
        return request, list(fds)
    except Exception:
        for fd in fds:
            os.close(fd)
        raise


def check_pacman(argv):
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        raise ValueError("malformed command")
    if os.path.basename(argv[0]) != "pacman":
        raise ValueError(f"only pacman may run as root, not {argv[0]!r}")
    args = argv[1:]
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            break
        option, _, value = arg.partition("=")
        if option in PACMAN_DEFAULTS and (value or (args[i + 1] if i + 1 < len(args) else "")) == PACMAN_DEFAULTS[option]:
            i += 1 if value else 2
            continue
        if pacman_refused(arg):
            raise ValueError(f"pacman option {arg} is not allowed")
        if under_workspace(arg):
            raise ValueError(f"{arg} is in {WORKSPACE}")
        i += 1
    return [PACMAN, *args]


def parent(pid):
    stat = Path(f"/proc/{pid}/stat").read_text()
    return int(stat.rsplit(")", 1)[1].split()[1])


def check_caller(pid, helper_pid):
    """The client must be a direct child of the helper process we started (PKGBUILD code runs
    deeper, below makepkg). Relies on the kernel refusing ptrace of non-descendants (Yama)."""
    if parent(pid) != helper_pid:
        raise ValueError("request does not come from the AUR helper")


def serve(server, uid, helper):
    while True:
        try:
            conn, _ = server.accept()
        except OSError:
            return
        with conn:
            fds = []
            try:
                creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
                peer_pid, peer_uid, _gid = struct.unpack("3i", creds)
                if peer_uid != uid:
                    raise ValueError(f"request from UID {peer_uid} refused")
                check_caller(peer_pid, helper())
                request, fds = receive(conn)
                command = check_pacman(request.get("argv"))
                cwd = request.get("cwd") if isinstance(request.get("cwd"), str) else "/"
                if not os.path.isdir(cwd) or under_workspace(cwd):
                    cwd = "/"
                rc = subprocess.run(command, stdin=fds[0], stdout=fds[1], stderr=fds[2], cwd=cwd,
                                    env=clean_env(HOME="/root"), check=False).returncode
            except Exception as exc:  # noqa: BLE001 - every failure is a refusal with a reply
                print(f"ocs-aur: refused: {exc}", file=sys.stderr)
                rc = 1
            finally:
                for fd in fds:
                    os.close(fd)
            try:
                conn.sendall(json.dumps({"rc": rc}).encode())
            except OSError:
                pass


def main(args):
    if os.geteuid() != 0:
        fail("run as root (the container's default user); the AUR helper then runs as " + USER)
    for arg in args:
        if refused_option(arg, HELPER_REFUSED):
            fail(f"option {arg} is managed by ocs-aur")
        if under_workspace(arg):
            fail(f"AUR builds never use {WORKSPACE}: {arg}")
    os.umask(0o022)  # docker exec inherits rootless dockerd's umask 0000
    user = pwd.getpwnam(USER)
    RUN_DIR.mkdir(mode=0o755, exist_ok=True)
    private = Path(tempfile.mkdtemp(prefix="broker-", dir=RUN_DIR))
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        os.chown(private, 0, user.pw_gid)
        private.chmod(0o750)
        path = private / "socket"
        server.bind(str(path))
        os.chown(path, 0, user.pw_gid)
        path.chmod(0o660)
        server.listen(4)
        command = ["runuser", "-u", USER, "--", HELPER, "--sudo", SUDO, "--nosudoloop", *args]
        env = clean_env(HOME=user.pw_dir, USER=USER, LOGNAME=USER, OCS_AUR_SOCKET=str(path))
        proc = subprocess.Popen(command, cwd=user.pw_dir, env=env)

        def helper():
            # runuser forks once (PAM session) and runs the helper as its only child.
            children = Path(f"/proc/{proc.pid}/task/{proc.pid}/children").read_text().split()
            if len(children) != 1:
                raise ValueError("AUR helper process not found")
            return int(children[0])

        threading.Thread(target=serve, args=(server, user.pw_uid, helper), daemon=True).start()
        try:
            return proc.wait()
        except KeyboardInterrupt:
            proc.send_signal(signal.SIGINT)
            return proc.wait()
    finally:
        try:
            server.shutdown(socket.SHUT_RDWR)  # wakes the accept() in the broker thread
        except OSError:
            pass
        server.close()
        shutil.rmtree(private, ignore_errors=True)


if __name__ == "__main__":
    if Path(sys.argv[0]).name == "sudo":
        sys.exit(elevate(sys.argv[1:]))
    sys.exit(main(sys.argv[1:]))
